<Window x:Class="DesktopAutoAI.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAutoAI" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: target picker -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Target:" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontWeight="Bold"/>
            <ComboBox Grid.Column="1" x:Name="TargetCombo"
                      DisplayMemberPath="Display"
                      MinHeight="28"/>
            <Button Grid.Column="2" Content="Refresh" Click="OnRefresh" Margin="8,0,0,0"/>
            <Button Grid.Column="3" Content="Pick foreground..." Click="OnPickForeground"
                    Margin="8,0,0,0" ToolTip="Minimises this window for 3 seconds and grabs whatever window you focus next."/>
        </Grid>

        <!-- Row 1: prompt -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Prompt (Ctrl+Enter to run):" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" x:Name="PromptBox" Height="90"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Segoe UI" FontSize="14"
                     KeyDown="OnPromptKeyDown"/>
        </Grid>

        <!-- Row 2: actions + flags -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RunBtn" Content="Run" Click="OnRun"
                    FontWeight="Bold" Padding="22,6"/>
            <Button Grid.Column="1" x:Name="StopBtn" Content="Stop" Click="OnStop"
                    Margin="8,0,0,0" IsEnabled="False"/>
            <CheckBox Grid.Column="3" x:Name="UseCacheCb" Content="Use cache"
                      VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                      ToolTip="When checked, look up and save successful runs in %LOCALAPPDATA%\DesktopAutoAI\skills."/>
            <CheckBox Grid.Column="4" x:Name="UseSafetyCb" Content="Safety on"
                      VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                      ToolTip="When checked, destructive actions require confirmation and the kill-switch hotkey is armed."/>
            <CheckBox Grid.Column="5" x:Name="AutoYesCb" Content="Auto-confirm"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Auto-approve every destructive prompt for this run."/>
            <Button Grid.Column="6" Content="Clear log" Click="OnClearLog"/>
        </Grid>

        <!-- Row 3: log viewer -->
        <Border Grid.Row="3" BorderBrush="#888" BorderThickness="1" Background="#1e1e1e">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"
                     Background="#1e1e1e" Foreground="#e0e0e0"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,1"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Row 4: status bar -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem x:Name="StatusItem" Content="Ready."/>
            <Separator/>
            <StatusBarItem x:Name="PlannerItem" Content=""/>
        </StatusBar>
    </Grid>
</Window>
